{
    "Jobs": {
        "$ref-with-overwrite": "../../../../configuration/datawarehouse.d/jobs.json#/Jobs",
        "$overwrite": {
            "group_bys": {
                "none": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-none.json"
                },
                "day": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-time-period.json#/day"
                },
                "month": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-time-period.json#/month"
                },
                "quarter": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-time-period.json#/quarter"
                },
                "year": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-time-period.json#/year"
                },
                "person": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-common.json#/person"
                },
                "username": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-common.json#/username"
                },
                "queue": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-common.json#/queue"
                },
                "fieldofscience": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-hierarchy.json#/fieldofscience"
                },
                "parentscience": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-hierarchy.json#/parentscience"
                },
                "institution": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-common.json#/institution"
                },
                "pi_institution": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/group-by-common.json#/pi_institution"
                },
                "institution_state": {
                    "additional_join_constraints": [
                        {
                            "aggregate_expr": "state_id",
                            "aggregate_table": "organization",
                            "attribute_expr": "id",
                            "attribute_table": "state",
                            "operation": "="
                        }
                    ],
                    "alternate_group_by_columns": [
                        "id"
                    ],
                    "attribute_table_schema": "modw",
                    "attribute_to_aggregate_table_key_map": [
                        {
                            "organization.id": "person_organization_id"
                        }
                    ],
                    "attribute_description_query": "SELECT name AS filter_name FROM modw.state WHERE id IN (__filter_values__) ORDER BY name",
                    "attribute_filter_map_query": {
                        "person_organization_id": "SELECT DISTINCT id FROM modw.organization WHERE state_id IN (__filter_values__)"
                    },
                    "attribute_values_query": {
                        "joins": [
                            {
                                "name": "state",
                                "on": "state.id = organization.state_id"
                            },
                            {
                                "name": "organization",
                                "on": "agg.person_organization_id = organization.id"
                            }
                        ],
                        "orderby": [
                            "name"
                        ],
                        "records": {
                            "id": "id",
                            "name": "name",
                            "order_id": "name",
                            "short_name": "name"
                        }
                    },
                    "category": "Administrative",
                    "description_html": "The location of the institution of the person who ran the compute job.",
                    "name": "User Institution State"
                },
                "institution_country": {
                    "additional_join_constraints": [
                        {
                            "aggregate_expr": "country_id",
                            "aggregate_table": "organization",
                            "attribute_expr": "id",
                            "attribute_table": "country",
                            "operation": "="
                        }
                    ],
                    "alternate_group_by_columns": [
                        "id"
                    ],
                    "attribute_table_schema": "modw",
                    "attribute_to_aggregate_table_key_map": [
                        {
                            "organization.id": "person_organization_id"
                        }
                    ],
                    "attribute_description_query": "SELECT name AS filter_name FROM modw.country WHERE id IN (__filter_values__) ORDER BY name",
                    "attribute_filter_map_query": {
                        "person_organization_id": "SELECT DISTINCT id FROM modw.organization WHERE country_id IN (__filter_values__)"
                    },
                    "attribute_values_query": {
                        "joins": [
                            {
                                "name": "country",
                                "on": "country.id = organization.country_id"
                            },
                            {
                                "name": "organization",
                                "on": "agg.person_organization_id = organization.id"
                            }
                        ],
                        "orderby": [
                            "name"
                        ],
                        "records": {
                            "id": "id",
                            "name": "name",
                            "order_id": "name",
                            "short_name": "name"
                        }
                    },
                    "category": "Administrative",
                    "description_html": "The name of the country of the institution of the person who ran the compute job.",
                    "name": "User Institution Country"
                },
                "pi_institution_state": {
                    "additional_join_constraints": [
                        {
                            "aggregate_expr": "state_id",
                            "aggregate_table": "organization",
                            "attribute_expr": "id",
                            "attribute_table": "state",
                            "operation": "="
                        }
                    ],
                    "alternate_group_by_columns": [
                        "id"
                    ],
                    "attribute_table_schema": "modw",
                    "attribute_to_aggregate_table_key_map": [
                        {
                            "organization.id": "piperson_organization_id"
                        }
                    ],
                    "attribute_description_query": "SELECT name AS filter_name FROM modw.state WHERE id IN (__filter_values__) ORDER BY name",
                    "attribute_filter_map_query": {
                        "piperson_organization_id": "SELECT DISTINCT id FROM modw.organization WHERE state_id IN (__filter_values__)"
                    },
                    "attribute_values_query": {
                        "joins": [
                            {
                                "name": "state",
                                "on": "state.id = organization.state_id"
                            },
                            {
                                "name": "organization",
                                "on": "agg.piperson_organization_id = organization.id"
                            }
                        ],
                        "orderby": [
                            "name"
                        ],
                        "records": {
                            "id": "id",
                            "name": "name",
                            "order_id": "name",
                            "short_name": "name"
                        }
                    },
                    "category": "Administrative",
                    "description_html": "The location of the institution of the PI of the project associated with the compute jobs.",
                    "name": "PI Institution State"
                },
                "pi_institution_country": {
                    "additional_join_constraints": [
                        {
                            "aggregate_expr": "country_id",
                            "aggregate_table": "organization",
                            "attribute_expr": "id",
                            "attribute_table": "country",
                            "operation": "="
                        }
                    ],
                    "alternate_group_by_columns": [
                        "id"
                    ],
                    "attribute_table_schema": "modw",
                    "attribute_to_aggregate_table_key_map": [
                        {
                            "organization.id": "piperson_organization_id"
                        }
                    ],
                    "attribute_description_query": "SELECT name AS filter_name FROM modw.country WHERE id IN (__filter_values__) ORDER BY name",
                    "attribute_filter_map_query": {
                        "piperson_organization_id": "SELECT DISTINCT id FROM modw.organization WHERE country_id IN (__filter_values__)"
                    },
                    "attribute_values_query": {
                        "joins": [
                            {
                                "name": "country",
                                "on": "country.id = organization.country_id"
                            },
                            {
                                "name": "organization",
                                "on": "agg.piperson_organization_id = organization.id"
                            }
                        ],
                        "orderby": [
                            "name"
                        ],
                        "records": {
                            "id": "id",
                            "name": "name",
                            "order_id": "name",
                            "short_name": "name"
                        }
                    },
                    "category": "Administrative",
                    "description_html": "The country of the institution of the PI of the project associated with compute jobs.",
                    "name": "PI Institution Country"
                },
                "disabled_group_by": {
                    "#": "This group by is disabled and should not be considered at all",
                    "disabled": true,
                    "name": "Disabled Group By",
                    "description_html": "Disabled GroupBy",
                    "attribute_to_aggregate_table_key_map": [
                    ],
                    "attribute_values_query": {
                    }
                }
            },
            "statistics": {
                "running_job_count": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/Jobs-statistics.json#/running_job_count"
                },
                "job_count": {
                    "$ref": "../../../../configuration/datawarehouse.d/ref/Jobs-statistics.json#/job_count"
                },
                "disabled_statistic": {
                    "#": "This statistic is disabled and should not be considered at all",
                    "disabled": true,
                    "formula": "1",
                    "name": "1",
                    "description_html": "Disabled Statistic",
                    "unit": "Disabled"
                }
            }
        }
    }
}
