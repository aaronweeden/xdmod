{
    "configuration": {
        "name": "Instance Type",
        "description_html": "The instance type of a virtual machine.",
        "order": 6,
        "query": {
            "joins": [
                {
                    "agg_column": "instance_type_id",
                    "right_schema": "modw_cloud",
                    "right_table": "instance_type",
                    "right_column": "instance_type_id"
                }
            ],
            "records": {
                "id": "display",
                "short_name": "display",
                "name": "display",
                "order_id": "display"
            },
            "query_hint": "DISTINCT"
        }
    },
    "domain": {
        "name": "Domain",
        "description_html": "A domain is a high-level container for projects, users and groups",
        "query": {
            "joins": [
                {
                    "agg_column": "domain_id",
                    "right_schema": "modw_cloud",
                    "right_table": "domains",
                    "right_column": "id",
                    "and": {
                        "agg_column": "host_resource_id",
                        "right_column": "resource_id"
                    }
                }
            ],
            "records": {
                "id": "name",
                "short_name": "name",
                "name": "name",
                "order_id": "name"
            },
            "query_hint": "DISTINCT"
        }
    },
    "none": {
        "$ref": "datawarehouse.d/ref/group-by-none.json"
    },
    "day": {
        "$ref": "datawarehouse.d/ref/group-by-time-period.json#/day"
    },
    "month": {
        "$ref": "datawarehouse.d/ref/group-by-time-period.json#/month"
    },
    "person": {
        "name": "User",
        "description_html": "A person on a principal investigator's allocation, able to spin up and manipulate VM instances.",
        "category": "Administrative",
        "query": {
            "joins": [
                {
                    "agg_column": "person_id",
                    "right_table": "person",
                    "right_column": "id"
                }
            ],
            "records": {
                "id": "id",
                "name": "long_name",
                "order_id": "order_id",
                "short_name": "short_name"
            }
        }
    },
    "project": {
        "name": "Project",
        "description_html": "The project associated with a VM.",
        "category": "Administrative",
        "query": {
            "joins": [
                {
                    "agg_column": "account_id",
                    "right_schema": "modw_cloud",
                    "right_table": "account",
                    "right_column": "account_id"
                }
            ],
            "records": {
                "id": "display",
                "name": "display",
                "order_id": "display",
                "short_name": "display"
            }
        }
    },
    "quarter": {
        "$ref": "datawarehouse.d/ref/group-by-time-period.json#/quarter"
    },
    "resource": {
        "$ref-with-overwrite": "datawarehouse.d/ref/group-by-common.json#/resource",
        "$overwrite": {
            "description_html": "A resource is defined as any infrastructure that hosts virtual machines.",
            "query": {
                "$ref-with-overwrite": "datawarehouse.d/ref/group-by-common.json#/resource/query",
                "$overwrite": {
                    "joins": [
                        {
                            "$ref-with-overwrite": "datawarehouse.d/ref/group-by-common.json#/resource/query/joins/0",
                            "$overwrite": {
                                "agg_column": "host_resource_id"
                            }
                        }
                    ]
                }
            }
        }
    },
    "provider": {
        "attribute_to_aggregate_table_key_map": [
            {
                "organization_id": "service_provider"
            }
        ],
        "query": {
            "joins": [
                {
                    "name": "serviceprovider"
                }
            ],
            "orderby": [
                "order_id"
            ],
            "records": {
                "id": "organization_id",
                "name": "long_name",
                "order_id": "order_id",
                "short_name": "short_name"
            }
        },
        "description_html": "A service provider is an institution that hosts resources.",
        "show_in_catalog": false
    },
    "submission_venue": {
        "name": "Submission Venue",
        "description_html": "The venue that a job or cloud instance was initiated from.",
        "category": "Administrative",
        "query": {
            "joins": [
                {
                    "agg_column": "submission_venue_id",
                    "right_table": "submission_venue",
                    "right_column": "submission_venue_id"
                }
            ],
            "records": {
                "id": "submission_venue_id",
                "name": "description",
                "order_id": "order_id",
                "short_name": "display"
            }
        }
    },
    "username": {
        "$ref": "datawarehouse.d/ref/group-by-common.json#/username"
    },
    "vm_size": {
        "name": "VM Size: Cores",
        "description_html": "A categorization of VM's into discrete groups based on the number of cores used by each VM.",
        "category": "Administrative",
        "attribute_table_schema": "modw_cloud",
        "attribute_to_aggregate_table_key_map": [
            {
                "id": "processorbucket_id"
            }
        ],
        "attribute_values_query": {
            "joins": [
                {
                    "name": "processor_buckets"
                }
            ],
            "orderby": [
                "id"
            ],
            "records": {
                "id": "id",
                "name": "description",
                "order_id": "id",
                "short_name": "description"
            }
        },
        "chart_options": {
            "dataset_display_type": {
                "aggregate": "bar",
                "timeseries": "area"
            }
        },
        "data_sort_order": null,
    },
    "vm_size_memory": {
        "attribute_table_schema": "modw_cloud",
        "attribute_to_aggregate_table_key_map": [
            {
                "id": "memorybucket_id"
            }
        ],
        "attribute_values_query": {
            "joins": [
                {
                    "name": "memory_buckets"
                }
            ],
            "orderby": [
                "id"
            ],
            "records": {
                "id": "id",
                "name": "description",
                "order_id": "id",
                "short_name": "min_memory"
            }
        },
        "category": "Administrative",
        "description_html": "A categorization of VM's into discrete groups based on the amount of memory reserved by each VM.",
        "name": "VM Size: Memory"
    },
    "instance_state": {
        "attribute_table_schema": "modw_cloud",
        "attribute_to_aggregate_table_key_map": [
            {
                "instance_state_id": "instance_state_id"
            }
        ],
        "attribute_values_query": {
            "joins": [
                {
                    "name": "instance_states"
                }
            ],
            "orderby": [
                "instance_state_id"
            ],
            "records": {
                "id": "instance_state_id",
                "name": "display",
                "order_id": "instance_state_id",
                "short_name": "display"
            }
        },
        "category": "Administrative",
        "description_html": "A categorization of VM based on their state, ex. Active, Inactive, etc.",
        "name": "VM State"
    },
